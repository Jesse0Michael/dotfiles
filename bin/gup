#!/bin/bash
set -euo pipefail

# gup [-f] [<parent>] - rebase the current branch onto origin's default branch.
# <parent> is the branch you forked from when it wasn't the default branch.
# -f force-pushes the result.

push=false
parent=
for arg in "$@"; do
    if [[ $arg == -f ]]; then push=true; else parent=$arg; fi
done

git fetch -p origin

onto=$(git symbolic-ref --short refs/remotes/origin/HEAD)

if [[ -n $(git status --porcelain) ]]; then
    git stash push -uq -m gup
    trap 'git stash pop --index -q || echo "gup: your changes are in stash@{0}" >&2' EXIT
fi

# Where your commits start and where they land are different questions.
# --fork-point answers the first, so a parent that was rebased or squash-merged
# never replays its commits into yours.
git rebase --fork-point --onto "$onto" "${parent:-$onto}"

if $push; then git push --force-with-lease -u origin HEAD; fi
