#!/bin/bash
set -euo pipefail

# gup - sync the current branch.
#
#   gup       rebase onto the default branch
#   gup A     rebase relative to A, the branch you branched off of:
#               A still open -> follow it, replaying just your commits
#               A merged     -> move your commits onto the default branch
#   -f        push the result
#
# Always --onto, because "where do my commits start" and "where do I land" are
# different questions. --fork-point answers the first, so a parent that was
# rebased or squashed never replays its commits into yours.

push=false
while getopts ":f" opt; do
    case "$opt" in
        f) push=true ;;
        *) echo "usage: gup [-f] [<parent>]" >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

git fetch --prune origin

main=$(git symbolic-ref --short refs/remotes/origin/HEAD)
name=${1:-$main}
name=${name#origin/}

# Merging deletes the parent from origin, so --prune above makes it vanish here
# too. The local branch stays behind and still marks where your commits start,
# which is all we need from it once we're landing on main instead.
if git rev-parse --verify --quiet "origin/$name^{commit}" >/dev/null; then
    ref=origin/$name
    dest=$ref
else
    ref=$name
    dest=$main
fi

echo "rebasing onto $dest"
git rebase --autostash --fork-point --onto "$dest" "$ref"

if $push; then
    git push --force-with-lease --set-upstream origin HEAD
fi
